# Copy to the repository root as .env (git-ignored) and replace every value. Never commit the real file.
MYSQL_DATABASE=bcs_study_hub
MYSQL_USER=bcs_app
MYSQL_PASSWORD=change-me-long-random
MYSQL_ROOT_PASSWORD=change-me-long-random
# At least 32 bytes of randomness, e.g.  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-at-least-32-bytes-of-random-data
JWT_ISSUER=BCSStudyHub
JWT_AUDIENCE=BCSStudyHub.Web
# The public URL users open, e.g. https://study.example.org (used for CORS)
PUBLIC_ORIGIN=https://study.example.org
# Host names the API answers to, separated by semicolons, e.g. study.example.org
ALLOWED_HOSTS=study.example.org
# true only for a first install or after reviewing pending migrations (see DEPLOYMENT.md)
APPLY_MIGRATIONS_ON_STARTUP=false
LIBRARY_MAX_FILE_BYTES=52428800
LIBRARY_USER_QUOTA_BYTES=2147483648
WEB_PORT=8080
